{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "convention_profile_v0_1_0": {
      "type": "object",
      "properties": {
        "perturbation_operator_convention": {
          "const": "+alpha*n"
        },
        "response_derivative_convention": {
          "const": "dN/dalpha"
        },
        "u_formula_convention": {
          "const": "inv(chi0)-inv(chi)"
        }
      },
      "required": [
        "perturbation_operator_convention",
        "response_derivative_convention",
        "u_formula_convention"
      ]
    }
  },
  "required": [
    "campaign_id",
    "convention_profile_v0_1_0"
  ],
  "not": {
    "required": [
      "sha256"
    ]
  }
}