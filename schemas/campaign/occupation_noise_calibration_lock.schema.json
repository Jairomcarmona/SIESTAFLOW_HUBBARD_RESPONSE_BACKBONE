{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiestaFlow externally calibrated occupation-noise methodology lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "preregistration", "calibration", "runtime", "observable", "reference_semantics", "input_provenance", "result_binding", "fail_closed"],
  "properties": {
    "schema": {"const": "siestaflow-occupation-noise-calibration-lock-v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "preregistration": {"type": "object", "additionalProperties": false, "required": ["declared_before_response_execution", "prohibited_inputs", "rationale"], "properties": {"declared_before_response_execution": {"const": true}, "prohibited_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "rationale": {"type": "string", "minLength": 1}}},
    "calibration": {"type": "object", "additionalProperties": false, "required": ["replica_count", "independence", "required_modes", "control_alpha_ev", "safety_factor", "output_quantum_e", "output_quantum_evidence", "deterministic_floor_e", "statistic", "zero_rule"], "properties": {"replica_count": {"type": "integer", "minimum": 3}, "independence": {"type": "string", "minLength": 1}, "required_modes": {"const": ["REFERENCE", "BARE", "SCREENED"]}, "control_alpha_ev": {"const": 0}, "safety_factor": {"type": "number", "minimum": 1}, "output_quantum_e": {"type": "number", "exclusiveMinimum": 0}, "output_quantum_evidence": {"type": "string", "minLength": 1}, "deterministic_floor_e": {"type": "number", "exclusiveMinimum": 0}, "statistic": {"type": "string", "minLength": 1}, "zero_rule": {"type": "string", "minLength": 1}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["siesta_executable", "siesta_sha256", "siesta_version", "mpi_launcher", "mpi_launcher_sha256", "mpi_kind", "nodes", "ranks", "omp_num_threads", "slurm_partition"], "properties": {"siesta_executable": {"type": "string", "minLength": 1}, "siesta_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "siesta_version": {"const": "5.4.2"}, "mpi_launcher": {"type": "string", "minLength": 1}, "mpi_launcher_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mpi_kind": {"const": "openmpi"}, "nodes": {"const": 1}, "ranks": {"const": 4}, "omp_num_threads": {"const": 1}, "slurm_partition": {"type": "string", "minLength": 1}}},
    "observable": {"type": "object", "additionalProperties": false, "required": ["atom", "projector", "scalar", "bare_event", "screened_event"], "properties": {"atom": {"type": "object", "additionalProperties": false, "required": ["index", "species"], "properties": {"index": {"const": 1}, "species": {"const": "Cu1"}}}, "projector": {"type": "object", "additionalProperties": false, "required": ["n", "l", "generation_method", "potential_shift"], "properties": {"n": {"const": 3}, "l": {"const": 2}, "generation_method": {"const": 2}, "potential_shift": {"const": true}}}, "scalar": {"const": "HubbardAtomPopulation.trace_total"}, "bare_event": {"type": "string", "minLength": 1}, "screened_event": {"type": "string", "minLength": 1}}},
    "reference_semantics": {"type": "object", "additionalProperties": false, "required": ["reference", "bare", "screened", "dm_rule"], "properties": {"reference": {"type": "string", "minLength": 1}, "bare": {"type": "string", "minLength": 1}, "screened": {"type": "string", "minLength": 1}, "dm_rule": {"type": "string", "minLength": 1}}},
    "input_provenance": {"type": "object", "additionalProperties": false, "required": ["reference_fdf", "reference_fdf_sha256", "source_template", "source_template_sha256", "pseudo", "pseudo_sha256"], "properties": {"reference_fdf": {"type": "string", "minLength": 1}, "reference_fdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_template": {"type": "string", "minLength": 1}, "source_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pseudo": {"type": "string", "minLength": 1}, "pseudo_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "result_binding": {"type": "object", "additionalProperties": false, "required": ["result_file", "required_fields", "consumer_must_match_lock_sha256", "consumer_must_not_accept_manual_numeric_override"], "properties": {"result_file": {"const": "results/calibration-result.json"}, "required_fields": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "consumer_must_match_lock_sha256": {"const": true}, "consumer_must_not_accept_manual_numeric_override": {"const": true}}},
    "fail_closed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
