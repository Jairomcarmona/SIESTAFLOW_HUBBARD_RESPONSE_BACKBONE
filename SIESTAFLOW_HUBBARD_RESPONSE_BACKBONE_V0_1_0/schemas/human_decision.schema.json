{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human_decision.schema.json",
  "title": "Human Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "candidate_id",
    "reviewer",
    "timestamp",
    "decision",
    "rationale",
    "reviewed_artifacts",
    "scientific_scope"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "REQUEST_MORE_EVIDENCE"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "scientific_scope": {
      "type": "string",
      "minLength": 1
    },
    "accepted_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "signature_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
