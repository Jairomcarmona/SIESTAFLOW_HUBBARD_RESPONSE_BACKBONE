{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response_dataset.schema.json",
  "title": "Response Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "candidate_id",
    "observations",
    "observable_ids",
    "target_ids"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "observable_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "target_id",
          "alpha",
          "mode",
          "observable_id",
          "value",
          "unit",
          "scf_valid",
          "magnetic_signature"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "alpha": {
            "type": "number"
          },
          "mode": {
            "enum": [
              "BARE",
              "SCREENED"
            ]
          },
          "observable_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "iteration": {
            "type": [
              "integer",
              "null"
            ]
          },
          "scf_valid": {
            "type": "boolean"
          },
          "magnetic_signature": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          }
        }
      }
    }
  }
}
