{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perturbation_policy.schema.json",
  "title": "Perturbation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit",
    "initial_grid",
    "symmetric_about_zero",
    "adaptation",
    "limits"
  ],
  "properties": {
    "unit": {
      "enum": [
        "eV",
        "Ry",
        "Ha"
      ]
    },
    "initial_grid": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "number"
      }
    },
    "symmetric_about_zero": {
      "const": true
    },
    "adaptation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ACCEPT_WINDOW",
          "SHRINK_WINDOW",
          "EXPAND_WINDOW",
          "ADD_POINTS",
          "REJECT_CANDIDATE"
        ]
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_abs_alpha",
        "max_points"
      ],
      "additionalProperties": false,
      "properties": {
        "max_abs_alpha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_points": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "zero_policy": {
      "enum": [
        "shared_reference",
        "explicit_run_per_target"
      ]
    }
  }
}
