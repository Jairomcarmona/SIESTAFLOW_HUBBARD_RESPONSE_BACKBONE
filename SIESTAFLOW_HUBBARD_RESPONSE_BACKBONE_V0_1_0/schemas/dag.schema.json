{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dag.schema.json",
  "title": "Materialized DAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dag_id",
    "campaign_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "dag_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        }
      }
    },
    "materialization_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
