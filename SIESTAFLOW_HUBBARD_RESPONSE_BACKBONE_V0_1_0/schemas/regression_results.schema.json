{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression_results.schema.json",
  "title": "Regression Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "fits"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "fits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observable_id",
          "target_id",
          "mode",
          "slope",
          "intercept",
          "stderr",
          "r2",
          "adjusted_r2",
          "max_abs_residual",
          "curvature",
          "points_used",
          "gate_status"
        ],
        "properties": {
          "observable_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "mode": {
            "enum": [
              "BARE",
              "SCREENED"
            ]
          },
          "slope": {
            "type": "number"
          },
          "intercept": {
            "type": "number"
          },
          "stderr": {
            "type": "number",
            "minimum": 0
          },
          "r2": {
            "type": "number"
          },
          "adjusted_r2": {
            "type": "number"
          },
          "max_abs_residual": {
            "type": "number",
            "minimum": 0
          },
          "curvature": {
            "type": "number",
            "minimum": 0
          },
          "positive_slope": {
            "type": [
              "number",
              "null"
            ]
          },
          "negative_slope": {
            "type": [
              "number",
              "null"
            ]
          },
          "points_used": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "gate_status": {
            "enum": [
              "PASS",
              "FAIL",
              "INDETERMINATE"
            ]
          }
        }
      }
    }
  }
}
