{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate_results.schema.json",
  "title": "Gate Results",
  "$defs": {
    "gate_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "metric",
        "operator",
        "threshold",
        "missing_data_policy"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            ">",
            ">=",
            "==",
            "between",
            "custom"
          ]
        },
        "threshold": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "missing_data_policy": {
          "enum": [
            "FAIL",
            "INDETERMINATE"
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "results"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status",
          "observed",
          "definition",
          "evidence_refs"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INDETERMINATE"
            ]
          },
          "observed": {},
          "definition": {
            "$ref": "#/$defs/gate_definition"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
