{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace_event.schema.json",
  "title": "Trace Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "task_id",
    "event",
    "data"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "event": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "data": {
      "type": "object"
    }
  }
}
