SystemName          NiO Hubbard Benchmark
SystemLabel NiO_SCREENING_3POINT_alpha0.0000_SCREENED

NumberOfAtoms       4
NumberOfSpecies 3

%block ChemicalSpeciesLabel
  1  28  NiLR0
  2  28  NiLR1
  3   8  O
%endblock ChemicalSpeciesLabel

LatticeConstant     4.1770 Ang
%block LatticeVectors
  0.000000  1.000000  1.000000
  0.500000  0.000000  0.500000
  0.500000  0.500000  0.000000
%endblock LatticeVectors

AtomicCoordinatesFormat  Fractional
%block AtomicCoordinatesAndAtomicSpecies
    0.000000    0.000000    0.000000    1   # NiLR0
    0.500000    0.000000    0.000000    2   # NiLR1
    0.250000    0.500000    0.500000    3   # O
    0.750000    0.500000    0.500000    3   # O
%endblock AtomicCoordinatesAndAtomicSpecies

PAO.BasisSize       DZP
PAO.EnergyShift     0.005 Ry
PAO.SplitNorm       0.15
PAO.BasisType       split

MeshCutoff          200 Ry
%block kgrid_Monkhorst_Pack
  4 0 0 0.0
  0 4 0 0.0
  0 0 4 0.0
%endblock kgrid_Monkhorst_Pack

MaxSCFIterations    200
Spin polarized
%block DM.InitSpin
  1  +2.0
  2  -2.0
  3  +0.0
  4  +0.0
%endblock DM.InitSpin
MD.NumCGsteps       0

%block DFTU.proj
  NiLR0   1
  3  2
  0.0000  0.0000
  3.0000  0.0500
  NiLR1   1
  3  2
  0.0000  0.0000
  3.0000  0.0500
%endblock DFTU.proj
DFTU.PotentialShift true
DFTU.ProjectorGenerationMethod 2
DFTU.FirstIteration true
DM.UseSaveDM true
