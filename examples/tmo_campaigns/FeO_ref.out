reinit: Reading from standard input
reinit: Dumping input in INPUT_TMP.08392
************************** Dump of input data file ****************************
SystemName          Iron Oxide (Rock-salt)
SystemLabel         FeO_ref
NumberOfAtoms       2
NumberOfSpecies     2
%block ChemicalSpeciesLabel
 1  26  Fe
 2   8  O
%endblock ChemicalSpeciesLabel
# Primitive cell of FCC Rock-salt (a = 4.33 Angstroms)
LatticeConstant     4.33 Ang
%block LatticeVectors
  0.0  0.5  0.5
  0.5  0.0  0.5
  0.5  0.5  0.0
%endblock LatticeVectors
# Atom coordinates (fractional)
AtomicCoordinatesFormat  Fractional
%block AtomicCoordinatesAndAtomicSpecies
 0.0  0.0  0.0   1   # Fe at origin
 0.5  0.5  0.5   2   # O at half diagonal
%endblock AtomicCoordinatesAndAtomicSpecies
# Hyper-lightweight parameters for campaign
PAO.BasisSize       DZP        # Double-Zeta Polarization basis for realistic screening
MeshCutoff          150 Ry
%block kgrid_Monkhorst_Pack
 2 0 0 0.0
 0 2 0 0.0
 0 0 2 0.0
%endblock kgrid_Monkhorst_Pack
# SCF settings
MaxSCFIterations    50
DM.MixingWeight     0.1
DM.NumberPulay      3
# Spin polarization
Spin                polarized
%block DM.InitSpin
 1 +4.0
 2  0.0
%endblock DM.InitSpin
# -------- HUBBARD U SETTINGS --------
DFTU.ProjectorGenerationMethod  1  # Use PAO orbitals
DFTU.PotentialShift true
# Output controls
WriteCoorXmol       true
WriteForces         true
WriteDM             true
%block DFTU.proj
  Fe   1
  3  2
  0.0000  0.0000
  0.0000
%endblock DFTU.proj
DM.UseSaveDM true
************************** End of input data file *****************************

