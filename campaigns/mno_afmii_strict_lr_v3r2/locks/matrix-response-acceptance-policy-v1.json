{
  "schema": "siestaflow-matrix-response-acceptance-policy-v1",
  "scope": "matrix finite-response analysis; applies after per-channel linearity and magnetic-state checks",
  "alpha_selection": {
    "require_channel_signal": false,
    "residual_relative": 0.02,
    "slope_relative": 0.05,
    "magnetic_tolerance": 0.05
  },
  "matrix_acceptance": {
    "max_antisymmetry_relative": 0.05,
    "max_condition_number": 1000000.0,
    "max_inverse_relative_error": 0.1,
    "noise_multiplier": 1.0
  }
}
