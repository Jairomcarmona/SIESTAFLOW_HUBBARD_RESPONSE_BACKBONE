************************** Dump of input data file ****************************
DFTU.PopTol 1.0e-5
SystemName MnO AFM-II PBE+LR-U central V6
SystemLabel MNCL
NumberOfAtoms 4
NumberOfSpecies 3
%block ChemicalSpeciesLabel
  1 25 MnLR0
  2 25 MnLR1
  3 8 O
%endblock ChemicalSpeciesLabel
LatticeConstant 4.4455 Ang
%block LatticeVectors
  0.0 1.0 1.0
  0.5 0.0 0.5
  0.5 0.5 0.0
%endblock LatticeVectors
AtomicCoordinatesFormat Fractional
%block AtomicCoordinatesAndAtomicSpecies
  0.00 0.00 0.00 1 # MnLR0 / AFM-II A
  0.50 0.00 0.00 2 # MnLR1 / AFM-II B
  0.25 0.50 0.50 3 # O
  0.75 0.50 0.50 3 # O
%endblock AtomicCoordinatesAndAtomicSpecies
XC.Functional GGA
XC.Authors PBE
PAO.BasisSize DZP
PAO.EnergyShift 0.005 Ry
PAO.SplitNorm 0.15
PAO.BasisType split
MeshCutoff 200 Ry
%block kgrid_Monkhorst_Pack
  2 0 0 0.0
  0 4 0 0.0
  0 0 4 0.0
%endblock kgrid_Monkhorst_Pack
OccupationFunction FD
ElectronicTemperature 300 K
MaxSCFIterations 300
Spin polarized
%block DM.InitSpin
  1 +5.0
  2 -5.0
  3 0.0
  4 0.0
%endblock DM.InitSpin
DFTU.ProjectorGenerationMethod 2
DFTU.CutoffNorm 0.90
DFTU.PotentialShift false
DFTU.FirstIteration true
DM.UseSaveDM true
WriteMullikenPop 1
WriteDM true
MD.NumCGsteps 0
SCF.MustConverge true
SCF.Mix Hamiltonian
SCF.Mixer.Method Pulay
SCF.Mixer.Weight 0.05
SCF.Mixer.History 8
SCF.DM.Converge true
SCF.H.Converge true
SCF.DM.Tolerance 1.0e-5
SCF.H.Tolerance 1.0e-4 eV
%block DFTU.proj
  MnLR0 1
  3 2
  11.117477005325092 0.000000000000000
  0.0000 0.0500
  MnLR1 1
  3 2
  11.115065146109803 0.000000000000000
  0.0000 0.0500
%endblock DFTU.proj
